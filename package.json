{
  "name": "do-harness-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && bun scripts/force-server-port.cjs",
    "start": "NODE_ENV=production FORCE_PORT=3000 bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "build:pages": "sh scripts/build-pages.sh",
    "deploy:pages": "sh scripts/deploy-gh-pages.sh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
